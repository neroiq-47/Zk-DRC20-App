{
  "expo": {
    "name": "Zoko",
    "slug": "zoko",
    "scheme": "zoko",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F7FAFC",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#146FF4"
    },
    "ios": {
      "bundleIdentifier": "app.zoko.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Zoko uses your photo library so you can add photos and videos to posts and your profile.",
        "NSCameraUsageDescription": "Zoko uses the camera so you can capture photos and videos for posts.",
        "NSMicrophoneUsageDescription": "Zoko uses the microphone to record sound with videos you capture.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.zoko.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#146FF4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Zoko uses your photo library so you can add photos and videos to posts and your profile.",
          "cameraPermission": "Zoko uses the camera so you can capture photos and videos for posts."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#146FF4"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#146FF4"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
