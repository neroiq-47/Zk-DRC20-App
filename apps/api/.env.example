# Zoko API configuration. Copy to .env (or export) — every value has a dev default.
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
# Absolute base used for media URLs and upload URLs returned to the app.
# On a phone, use your machine's LAN address, e.g. http://192.168.1.20:4000
PUBLIC_BASE_URL=http://localhost:4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/zoko
DB_POOL_MAX=10

# Auth. JWT_SECRET is required (>= 32 chars) in production.
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-0123456789
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=60000
TRUST_PROXY=false
# Comma separated origins, or * (dev default). Empty in production = no browser origins.
CORS_ORIGINS=*

# Wallet proof: domain bound into the sign-in message.
APP_DOMAIN=zoko.app

# Media (local disk driver, relative to apps/api)
STORAGE_DIR=storage

# Background worker (chain sync, transfer monitor, push outbox) in the API process.
WORKER_ENABLED=true
WORKER_INTERVAL_MS=5000

# Expo push notifications (best effort)
PUSH_ENABLED=false
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_ACCESS_TOKEN=

# Chain: simulated (dev/test only) | rpc (Dogecoin Core JSON-RPC, txindex=1) | none
CHAIN_SOURCE=simulated
DOGECOIN_RPC_URL=
DOGECOIN_RPC_USER=
DOGECOIN_RPC_PASSWORD=
CHAIN_SYNC_START_DEPTH=12
REQUIRED_CONFIRMATIONS=6
SIM_CHAIN_STATE_PATH=storage/sim-chain.json
# Auto-mine one simulated block every N ms (0 disables). Use `pnpm --filter @zoko/api chain:mine 6` to mine on demand.
SIM_BLOCK_INTERVAL_MS=30000

# Transfer builder: simulated (dev/test only) | none (prepare returns 501 transfer_builder_unavailable)
TRANSFER_BUILDER=simulated

# Balance indexers, comma separated: "fixture" (dev/test only) or base URLs speaking the
# Zoko indexer adapter protocol (see src/indexer/adapter.ts). Use >= 2 independent ones.
INDEXERS=fixture,fixture
INDEXER_FIXTURE_PATH=fixtures/indexer.json
ASSET_STALE_SECONDS=60

# Dev-only endpoints under /api/v1/dev (mine/reorg simulated chain, simulated signing). Refused in production.
DEV_ENDPOINTS=true
LOG_LEVEL=info
